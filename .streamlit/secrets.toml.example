# Copy this file to `.streamlit/secrets.toml` for local runs, and paste the same
# keys into Streamlit Community Cloud → your app → Settings → Secrets for cloud.
# DO NOT commit the real secrets.toml (it's gitignored).

# Your Nightscout site. Any of these forms works — the app normalizes it:
#   https://your-site.up.railway.app
#   https://your-site.up.railway.app/api/v1/entries.json
NIGHTSCOUT_URL = "https://your-nightscout-site"

# Enables the AI report section. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY = "sk-ant-..."

# Optional: override the model used for the written report (default claude-opus-5)
# REPORT_MODEL = "claude-opus-5"

# Optional but recommended in the cloud: gate the app behind a password.
APP_PASSWORD = "choose-a-strong-password"

# Optional: force display units regardless of the Nightscout server setting.
# DISPLAY_UNITS = "mmol"   # or "mgdl"
